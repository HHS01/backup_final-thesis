# ==============================================================================
# KoboToolbox Configuration Template (Copy to .env)
# ==============================================================================
KOBO_SERVER="https://kf.kobotoolbox.org"
KOBO_TOKEN="your_kobo_api_token_here"

# Asset UIDs from Kobo URL: kobotoolbox.org/#/forms/<UID>/landing
KOBO_UID_TEACHER="your_teacher_asset_uid"
KOBO_UID_PROVIDER="your_provider_asset_uid"
KOBO_UID_EXPERT="your_expert_asset_uid"
KOBO_UID_FOLLOWUP="your_followup_asset_uid"
